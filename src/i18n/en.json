    "gstApiGuide": {
      "title": "How to set up & use",
      "intro": "Generate government E-Invoice (IRN) and E-Way Bills from GST tax invoices and distribution challans. Follow the steps below, then save your settings.",
      "setupTitle": "One-time setup",
      "setup1": "Turn on Enable E-Invoice & E-Way Bill. Choose Manual (Portal) for JSON + import response, or Automatic (API) for one-click NIC generation.",
      "setup2": "Manual (Portal): download JSON from Dhandho, upload on einvoice1.gst.gov.in / ewaybillgst.gov.in, then Import response JSON. Automatic (API): enter NIC credentials below.",
      "setup3": "Enter Seller GSTIN and Dispatch PIN (6-digit pincode of your dispatch location), then click Save GST API Settings.",
      "setup4": "Optional: tick Generate E-Way Bill with E-Invoice for one combined E-Inv + EWB button when goods move with the invoice.",
      "setup5": "For Sandbox or Production, enter NIC Username, Client ID, Password, and Client Secret from the government portal.",
      "setup6": "Click Check e-invoice to confirm your GSTIN is registered for e-invoicing.",
      "useTitle": "Day-to-day use",
      "use1": "Invoices: open a GST tax invoice. Manual mode: E-Invoice JSON → portal → Import response. API mode: E-Invoice button generates IRN.",
      "use2": "Signed QR comes from portal response — Dhandho renders it on print. Cancel IRN/EWB within 24 hours (API mode) or on govt portal (manual mode).",
      "use3": "E-Way: fill transport details (Tally-style form), download JSON or generate via API. After EWB cancel you can re-file on the same invoice; after IRN cancel you need a new invoice number.",
      "use4": "Distribution: on manufacturer/distributor tenants, the same toolbar appears on each GST batch when E-Invoice is enabled.",
      "use5": "After changing the master toggle, refresh the page or log in again so buttons show or hide on all screens.",
      "tipsTitle": "Tips",
      "tip1": "Mock mode returns test IRNs instantly — nothing is filed with the government.",
      "tip2": "Buyer or vendor address should include a 6-digit pincode for Pin-to-pin distance lookup.",
      "tip3": "If Seller GSTIN is empty, company GSTIN from Tax Compliance is used automatically."
    }
